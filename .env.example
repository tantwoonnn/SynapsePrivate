# Copy this file to .env and add your Supabase and SMTP credentials. Never include .env in your submission ZIP.
APP_URL=http://localhost/Synapse
# Leave blank for the local XAMPP MySQL database. Set this only in hosted environments.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key. Never use it in browser code or commit it to GitHub.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tutor-applications
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Synapse
