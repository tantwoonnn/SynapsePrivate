# Copy this file to .env and add your Google OAuth credentials. Never include .env in your submission ZIP.
APP_URL=http://localhost/Synapse
# Leave blank for the local XAMPP MySQL database. Set this only in hosted environments.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
# Server-only Supabase secret key. Never use it in browser code or commit it to GitHub.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tutor-applications
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Synapse
